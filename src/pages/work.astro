---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "nmrs",
    url: "https://github.com/networkmanager-rs/nmrs",
    description: "Rust bindings for NetworkManager over D-Bus",
    image: "https://opengraph.githubassets.com/1/networkmanager-rs/nmrs"
  },
  {
    name: "payme",
    url: "https://github.com/cachebag/payme",
    description: "Personal finance tracker built for my homelab",
    image: "https://opengraph.githubassets.com/1/cachebag/payme"
  },
  {
    name: "jumpy",
    url: "https://github.com/cachebag/jumpy",
    description: "Min-maxing AI assisted programming in neovim",
    image: "https://opengraph.githubassets.com/1/cachebag/jumpy"
  },
  {
    name: "zerobrew",
    url: "https://github.com/lucasgelfond/zerobrew",
    description: "Optimized client and alternative for homebrew",
    image: "https://opengraph.githubassets.com/1/lucasgelfond/zerobrew"
  },
];

const contributions = [
  {
    name: "rustup",
    url: "https://github.com/rust-lang/rustup",
    description: "The Rust toolchain installer",
    image: "https://opengraph.githubassets.com/1/rust-lang/rustup"
  },
  {
  name: "pop-os/cosmic-applets",
    url: "https://github.com/pop-os/cosmic-applets",
    description: "Applets for cosmic-panel in pop!_os",
    image: "https://opengraph.githubassets.com/1/pop-os/cosmic-applets",
  },
  {
    name: "zbus",
    url: "https://github.com/z-galaxy/zbus",
    description: "A Rust API for D-Bus communication",
    image: "https://opengraph.githubassets.com/1/z-galaxy/zbus",
  }
];
---

<Layout title="software | akrm al-hakimi">
  <h1>software</h1>

  <p>
    much of the free-time i do have is spent working on software in rust, that of which i both own and contribute to/maintain.
    at work, i also develop rust, but we mainly use go for everything. </p>

  <p>
    i love talking about the work i'm doing (or really anything else revolving around OSS or programming) so if you'd like to chat, please reach out! i've left a list of my socials below.
    <ul>
      <li>email: <a href="mailto:akrm@cachebag.sh">akrm@cachebag.sh</a></li>
      <li>matrix: <a href="https://app.element.io/#/room/#zbus:matrix.org">@cachebag:matrix.org</a></li>
      <li>x(twitter): <a href="https://x.com/cachebagged">cachebagged</a></li>
      <li>linkedin: <a href="https://www.linkedin.com/in/akrmalhakimi/">akrm al-hakimi</a></li>
    </ul>
  </p>

  <p>
    i've also left a list of some of my projects below.
  </p>

  <h2>projects</h2>
  <ul>
    {projects.map(project => (
      <li>
        <a href={project.url} target="_blank">{project.name}</a> &mdash; {project.description}
        {project.image && (
          <a href={project.url} target="_blank" class="thumb">
            <img src={project.image} alt={project.name} />
          </a>
        )}
      </li>
    ))}
  </ul>

  <h2>other</h2>
  <ul>
    {contributions.map(item => (
      <li>
        <a href={item.url} target="_blank">{item.name}</a> &mdash; {item.description}
        {item.image && (
          <a href={item.url} target="_blank" class="thumb">
            <img src={item.image} alt={item.name} />
          </a>
        )}
      </li>
    ))}
  </ul>
</Layout>

<style>
  .thumb {
    display: inline-block;
    margin-top: 0.35rem;
  }

  .thumb img {
    width: 280px;
    height: 140px;
    object-fit: cover;
    object-position: top left;
    border: 1px solid #333;
    border-radius: 3px;
    display: block;
  }
</style>
