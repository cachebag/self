---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;

/** Newest first */
const journalEntries = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

function formatListDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
    timeZone: "UTC",
  });
}
---

<Layout
  title="journal — akrm al-hakimi"
  description="Updates on projects, work, and side interests."
>
  <h1>journal</h1>
  <p class="lede">short posts; newest first.</p>

  <ul class="entry-list">
    {journalEntries.map((e) => (
      <li>
        <a href={`${base}journal/${e.id}/`}>{e.data.title}</a>
        <span class="meta">
          <time datetime={e.data.date.toISOString().slice(0, 10)}>
            {formatListDate(e.data.date)}
          </time>
          {" — "}
          {e.data.description}
        </span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .lede {
    color: #888;
    margin-bottom: 1.5rem;
  }

  .entry-list {
    list-style: none;
    padding-left: 0;
  }

  .entry-list li {
    margin-bottom: 1.15rem;
  }

  .entry-list a {
    font-weight: 500;
  }

  .meta {
    display: block;
    color: #888;
    font-size: 0.9rem;
    margin-top: 0.2rem;
    line-height: 1.5;
  }
</style>
